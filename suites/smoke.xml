<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Suite" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="com.femaledaily.qa.listeners.TestListener"/>
    </listeners>
    
    <test name="API Smoke">
        <classes>
            <class name="com.femaledaily.qa.api.tests.AuthTest"/>
        </classes>
    </test>
    
    <test name="Web Smoke">
        <classes>
            <class name="com.femaledaily.qa.web.tests.LoginTest"/>
        </classes>
    </test>
</suite>
