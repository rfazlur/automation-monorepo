{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "decision",
    "required_evidence"
  ],
  "properties": {
    "decision": {
      "enum": [
        "pass",
        "pass_with_risk",
        "blocked"
      ]
    },
    "required_evidence": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "missing_evidence": {
      "type": "array"
    }
  }
}
