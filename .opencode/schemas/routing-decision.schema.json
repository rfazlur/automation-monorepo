{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "task_type",
    "risk",
    "complexity",
    "context_budget",
    "selected_agents"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "complexity": {
      "enum": [
        "simple",
        "medium",
        "complex"
      ]
    },
    "context_budget": {
      "type": "string"
    },
    "selected_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
