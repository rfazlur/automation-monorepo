{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "problem",
    "target_user",
    "scope",
    "non_goals"
  ],
  "properties": {
    "problem": {
      "type": "string"
    },
    "target_user": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
