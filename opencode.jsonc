    },
    "failure-analyzer": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 18,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "debugger": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 35
    },
    "flaky-test-analyzer": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 18,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "performance-reviewer": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 22,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "code-reviewer": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 22,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "security-reviewer": {
