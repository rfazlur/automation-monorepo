{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "@vheins/opencode-9router@latest"
  ],

  "default_agent": "orchestrator",
  "subagent_depth": 2,

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    },
    "task": "allow"
  },

  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "9router/combo-sonnet",
      "steps": 30
    },
    "router": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 15,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "context-compactor": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 15,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "repo-scout": {
      "mode": "subagent",
      "model": "9router/combo-free",
      "steps": 12,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "artifact-manager": {
      "mode": "subagent",
      "model": "9router/combo-free",
      "steps": 12,
      "permission": { "edit": "deny", "bash": "deny" }
    },

    "product-manager": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 18,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "product-owner": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 18,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "business-analyst": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 18,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "ux-researcher": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 18,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "product-analyst": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 18,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "technical-product-manager": {
      "mode": "subagent",
      "model": "9router/combo-sonnet",
      "steps": 20,
      "permission": { "edit": "deny", "bash": "deny" }
    },

    "planner": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 18,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "architect": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 22,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "debater": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 18,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "developer": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 35
    },
    "developer-standard": {
      "mode": "subagent",
      "model": "9router/combo-sonnet",
      "steps": 30
    },

    "qa-lead": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 20,
      "permission": { "edit": "deny" }
    },
    "test-designer": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 20,
      "permission": { "edit": "deny" }
    },
    "automation-engineer": {
      "mode": "subagent",
      "model": "9router/combo-sonnet",
      "steps": 30
    },
    "api-tester": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 22,
      "permission": { "edit": "deny" }
    },
    "ui-tester": {
